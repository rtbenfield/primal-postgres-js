{
  "extends": "@tsconfig/strictest",
  "compilerOptions": {
    "lib": ["ES2021.String", "ES2024.ArrayBuffer"],
    "moduleResolution": "node",
    "target": "ES2023",
    "outDir": "dist/",
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "rootDir": "src/",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
